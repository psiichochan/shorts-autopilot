# Copy this file to ".env" and fill in your keys. NEVER share .env or commit it (it is in .gitignore).
# Every key below is FREE. Only the first one is required to start.

# REQUIRED. Google Gemini (writes and checks the scripts): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Recommended: a second Gemini key from a different Google account, used by the second channel (clips),
# so the two channels don't share one free daily quota.
GEMINI_API_KEY_CLIPS=

# Recommended: stock video footage. https://pixabay.com/api/docs/ (key shown once you're logged in)
PIXABAY_API_KEY=
# Optional: Pexels stock video (https://www.pexels.com/api/), if you have a key
PEXELS_API_KEY=

# Optional backup AI models (used when Gemini is busy). All free sign-ups, no card:
GROQ_API_KEY=          # https://console.groq.com/keys
OPENROUTER_API_KEY=    # https://openrouter.ai/keys
NVIDIA_API_KEY=        # https://build.nvidia.com (email sign-up)
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=

# Optional: Instagram auto-posting (advanced; see docs). Leave empty to schedule Reels by hand in Meta Business Suite.
IG_USER_ID=
IG_ACCESS_TOKEN=
